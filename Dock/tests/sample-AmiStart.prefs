FONT NAME="helvetica.font" SIZE="13"
TASKBAR BACKDROP ICON="icons/start" TASKBARPOS="1"
NEWDIR NAME="MAIN" SPACE="4" PATTERN="0" RATIO="45" RGB="0xffffff" TEXTRGB="0x575c5c"
ITEM ICON="SYS:Tools/Calculator" NAME="Calculator" SMALL METHOD="0" CMDMODE="0" RGB="0x0" TEXTRGB="0x0" FILE="SYS:Tools/Calculator" EXECMODE="0" STACK="4096"
ENDDIR
NEWDIR NAME="TASKBAR" SPACE="0" PATTERN="0" RATIO="45" RGB="0xb4f7e" TEXTRGB="0xbcf0f5"
ITEM ICON="SYS:Disks" NAME="System" SMALL NOSTRING METHOD="0" CMDMODE="0" RGB="0x0" TEXTRGB="0x0" DIR="unnamed000000032" STACK="4096"
ITEM ICON="icons/Default/Shell" NAME="Shell" SMALL NOSTRING METHOD="0" CMDMODE="0" RGB="0x0" TEXTRGB="0x0" FILE="c:NewShell" EXECMODE="1" ARG="46524F4D20733A5368656C6C2D616D697374617274" STACK="8192"
ITEM ICON="SYS:Tools/Editor" NAME="Text Editor" SMALL NOSTRING METHOD="0" CMDMODE="0" RGB="0x0" TEXTRGB="0x0" FILE="SYS:Tools/Editor" EXECMODE="0" STACK="4096"
ITEM ICON="SYS:Prefs" NAME="Prefs" SMALL METHOD="0" CMDMODE="0" RGB="0x0" TEXTRGB="0x0" SYSDIR NAME="SYS:Prefs" SMALL SORTTYPE="0" ICONSONLY STACK="4096"
ITEM ICON="modules/showwindows" NAME="Windows" SMALL METHOD="0" CMDMODE="0" EXTERNAL PATTERN="0" FILE="showwindows" EXECMODE="0" STACK="4096"
ENDDIR
